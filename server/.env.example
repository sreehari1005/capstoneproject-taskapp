# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Port the API listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
# Local example : mongodb://127.0.0.1:27017/taskflow
# Atlas example : mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login token stays valid (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s), comma separated. Change to your live URL when deployed.
CLIENT_URL=http://localhost:5173
